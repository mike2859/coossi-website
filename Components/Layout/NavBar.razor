@using Coossi.Blazor.Data.Interfaces
@using Coossi.Blazor.Data.Models
@inject IContentStore ContentStore

<nav class="navbar navbar-expand-lg navbar-light fixed-top bg-white shadow-sm">
  <div class="container">
    @* <a class="navbar-brand text-danger" href="/">
      <i class="fas fa-fire-extinguisher me-2"></i>COOSSI
    </a> *@
    <a class="navbar-brand" href="/">
    <picture>
        <!-- fallback PNG si jamais le navigateur ne supporte pas WebP -->
        <source srcset="images/logo.webp" type="image/webp" />
        <img src="images/logo.webp" alt="COOSSI" height="50" />
    </picture>
</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav ms-auto">
        <li class="nav-item"><NavLink class="nav-link" href="/" Match="NavLinkMatch.All">Accueil</NavLink></li>
        @* <li class="nav-item"><NavLink class="nav-link" href="services">Services</NavLink></li> *@
        <li class="nav-item dropdown">
          <NavLink class="nav-link dropdown-toggle" href="prestations">Prestations</NavLink>
          @if (Prestations is { Count: > 0 })
          {
              <ul class="dropdown-menu">
                  @foreach (var p in Prestations)
                  {
                      <li>
                          <a class="dropdown-item" href="@($"/prestation/{p.Slug}")">
                              @if (!string.IsNullOrWhiteSpace(p.Icon))
                              {
                                  <i class="fas @p.Icon me-2" aria-hidden="true"></i>
                              }
                              @p.Title
                          </a>
                      </li>
                  }
              </ul>
          }
        </li>
        <li class="nav-item"><NavLink class="nav-link" href="references">Références</NavLink></li>
        <li class="nav-item"><NavLink class="nav-link" href="ils-nous-font-confiance">Nos réalisations</NavLink></li>
        <li class="nav-item"><NavLink class="nav-link" href="contact">Contact</NavLink></li>
      </ul>
    </div>
  </div>
</nav>

@code {
    private List<ServiceItem>? Prestations;

    protected override async Task OnInitializedAsync()
    {
        var index = await ContentStore.GetAsync<ServicesIndex>("prestations/_index");
        Prestations = index?.Items;
    }
}
