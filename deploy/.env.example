# Copier en .env (chmod 600) et remplir. Ne jamais commiter .env.

# Domaines servis par Caddy, séparés par des virgules.
# Phase de test : seulement le sous-domaine vps.
SITE_DOMAINS=vps.coossi-securite-incendie.eu
# Après bascule DNS :
# SITE_DOMAINS=www.coossi-securite-incendie.eu, coossi-securite-incendie.eu

# Relais SMTP du formulaire de contact. Sans ces lignes : SMTP Ikoula (contact@).
# Brevo (une fois le domaine authentifié dans Brevo) :
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USERNAME=<login « Connexion » de Brevo>@smtp-brevo.com

# Mot de passe SMTP : clé SMTP Brevo « site-coossi », ou mot de passe de contact@ chez Ikoula
SMTP_PASSWORD=
